# ==============================================================================
# Progenitor Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# Environment variables override values in config/*.json files.
# ==============================================================================

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ LLM PROVIDER CONFIGURATION                                                  │
# └─────────────────────────────────────────────────────────────────────────────┘

# Provider selection: "openai" or "azure" (default: azure)
# If AZURE_OPENAI_ENDPOINT is set, provider auto-detects to "azure"
PROGENITOR_LLM_PROVIDER=azure

# --- OpenAI (public API) ---
# OPENAI_API_KEY=sk-your-openai-api-key-here
# PROGENITOR_MODEL_DEFAULT=gpt-4o

# --- Azure OpenAI (recommended) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-api-key-here
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_DEFAULT=gpt-5-1-codex-max

# Optional: Per-role deployments (override default for specific tasks)
# AZURE_OPENAI_DEPLOYMENT_PLANNER=gpt-4o
# AZURE_OPENAI_DEPLOYMENT_BUILDER=gpt-5-1-codex-max
# AZURE_OPENAI_DEPLOYMENT_SUMMARY=gpt-4o-mini


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ RUNTIME CONFIGURATION                                                       │
# └─────────────────────────────────────────────────────────────────────────────┘

# Timezone for scheduled tasks (default: Australia/Melbourne)
PROGENITOR_TIMEZONE=Australia/Melbourne

# Logging level: debug, info, warn, error (default: info)
PROGENITOR_LOG_LEVEL=info

# Logging format: text (human-readable) or json (structured for production)
# JSON format is useful for log aggregation tools like ELK, Datadog, etc.
# PROGENITOR_LOG_FORMAT=text

# --- Loop Control ---
# Seconds to wait when idle before checking for work (default: 30)
PROGENITOR_IDLE_BACKOFF_SECONDS=30

# Maximum backoff in seconds when continuously idle (default: 300)
PROGENITOR_MAX_BACKOFF_SECONDS=300

# Backoff multiplier for exponential backoff (default: 1.5)
PROGENITOR_BACKOFF_MULTIPLIER=1.5

# Maximum tool/LLM calls per cycle (default: 10)
PROGENITOR_MAX_ACTIONS_PER_CYCLE=10

# Seconds between state checkpoints (default: 30)
PROGENITOR_CHECKPOINT_INTERVAL_SECONDS=30

# Timeout for user input before idle (default: 300)
PROGENITOR_INPUT_TIMEOUT_SECONDS=300

# --- Inner Loop (Dual Loop Architecture) ---
# Maximum inner loop iterations before giving up (default: 5)
# PROGENITOR_MAX_INNER_ITERATIONS=5


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ STORAGE PATHS                                                               │
# └─────────────────────────────────────────────────────────────────────────────┘
# Defaults are relative to project root when running locally,
# or /app/* paths when running in Docker.

# PROGENITOR_STATE_DIR=./data/state
# PROGENITOR_LOG_DIR=./logs
# PROGENITOR_WORKTREE_DIR=./worktrees
# PROGENITOR_PROMPTS_DIR=./data/prompts

# Timeout in seconds for acquiring file locks (default: 10)
PROGENITOR_STATE_LOCK_TIMEOUT_SECONDS=10


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ COPILOT CLI CONFIGURATION                                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# Path to Copilot CLI binary (default: copilot)
# PROGENITOR_COPILOT_BIN=copilot

# Timeout for Copilot CLI commands in seconds (default: 300)
PROGENITOR_COPILOT_TIMEOUT_SECONDS=300

# Path to copilot.json config file
# PROGENITOR_COPILOT_CONFIG=./config/copilot.json


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ TRANSPORT / MESSAGING                                                       │
# └─────────────────────────────────────────────────────────────────────────────┘

# Transport type: whatsapp, cli, webhook (default: whatsapp)
PROGENITOR_TRANSPORT=whatsapp

# Inbox/Outbox endpoints for message gateway
# PROGENITOR_INBOX_ENDPOINT=
# PROGENITOR_OUTBOX_ENDPOINT=

# Comma-separated list of allowed sender IDs (empty = allow all in single-user mode)
# PROGENITOR_ALLOWED_SENDERS=+1234567890,+0987654321


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ TELEMETRY / OBSERVABILITY                                                   │
# └─────────────────────────────────────────────────────────────────────────────┘
# OpenTelemetry-style metrics and tracing for monitoring and debugging.
# Exports to JSONL files and exposes Prometheus-compatible /metrics endpoint.

# Enable/disable telemetry (default: true)
PROGENITOR_TELEMETRY_ENABLED=true

# Directory for telemetry output files (default: {log_dir}/telemetry)
# PROGENITOR_TELEMETRY_DIR=./logs/telemetry

# Also print telemetry to console for debugging (default: false)
# PROGENITOR_TELEMETRY_CONSOLE=false

# Interval in seconds for metric snapshots (default: 15)
# PROGENITOR_TELEMETRY_METRICS_INTERVAL=15

# Names of output files (defaults: traces.jsonl, metrics.jsonl)
# PROGENITOR_TELEMETRY_TRACES_FILE=traces.jsonl
# PROGENITOR_TELEMETRY_METRICS_FILE=metrics.jsonl


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ LANGFUSE LLM OBSERVABILITY                                                  │
# └─────────────────────────────────────────────────────────────────────────────┘
# Langfuse provides comprehensive LLM observability including:
# - Automatic tracing of all LLM calls (prompts, completions, latency)
# - Token usage and cost tracking
# - Session and user tracking
# - Evaluation and scoring
#
# Setup:
# 1. Start docker-compose (includes self-hosted Langfuse)
# 2. Open http://localhost:3000 and create an account
# 3. Create a project and get API keys from Settings > API Keys
# 4. Set LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY below

# Enable/disable Langfuse integration (default: auto-enabled if keys present)
LANGFUSE_ENABLED=true

# Langfuse API keys (get from Langfuse UI > Settings > API Keys)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# Langfuse host URL (default uses cloud; docker-compose uses local)
# For docker-compose, this is set automatically to http://langfuse-web:3000
# For cloud: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
# LANGFUSE_HOST=http://localhost:3000

# Enable debug logging for Langfuse SDK (default: false)
# LANGFUSE_DEBUG=false

# Sample rate for tracing (0.0-1.0, default: 1.0 = trace all requests)
# Use lower values in high-traffic production to reduce costs
# LANGFUSE_SAMPLE_RATE=1.0

# Optional: Auth secrets for self-hosted Langfuse (generate with: openssl rand -base64 32)
# These are used by the Langfuse containers in docker-compose
LANGFUSE_NEXTAUTH_SECRET=changeme-generate-a-secret
LANGFUSE_SALT=changeme-generate-a-salt

# Disable Langfuse's own telemetry (recommended for self-hosted)
LANGFUSE_TELEMETRY_ENABLED=false


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ SCHEDULER CONFIGURATION                                                     │
# └─────────────────────────────────────────────────────────────────────────────┘

# Enable/disable scheduled task processing (default: true)
PROGENITOR_SCHEDULER_ENABLED=true

# How often to check for due scheduled tasks in seconds (default: 30)
PROGENITOR_SCHEDULER_POLL_SECONDS=30


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ CHAT SERVER CONFIGURATION                                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# Server bind address (default: 0.0.0.0)
CHAT_SERVER_HOST=0.0.0.0

# Server port (default: 8000)
CHAT_SERVER_PORT=8000

# Enable debug mode (default: false)
CHAT_SERVER_DEBUG=false

# Timeout waiting for Progenitor response in seconds (default: 300)
CHAT_SERVER_PROGENITOR_TIMEOUT=300

# Python executable for subprocess (default: python)
# CHAT_SERVER_PYTHON=python

# API metadata
CHAT_SERVER_API_TITLE=Progenitor Chat API
CHAT_SERVER_MODEL_NAME=progenitor-v1

# --- Rate Limiting ---
# Enable rate limiting (default: true)
CHAT_SERVER_RATE_LIMIT_ENABLED=true

# Maximum requests per minute per client (default: 60)
CHAT_SERVER_RATE_LIMIT_PER_MINUTE=60

# Maximum requests per hour per client (default: 500)
CHAT_SERVER_RATE_LIMIT_PER_HOUR=500

# --- Streaming ---
# Enable real-time token streaming for better UX (default: true)
# When enabled, responses are streamed token-by-token instead of waiting
# for the full response. Uses Server-Sent Events (SSE) format.
CHAT_SERVER_STREAM_ENABLED=true

# Optional delay between streaming chunks in milliseconds (default: 0)
# Set to 0 for fastest streaming, or add small delay for smoother display
# CHAT_SERVER_STREAM_CHUNK_DELAY_MS=0


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ DOCKER-SPECIFIC (set in docker-compose.yml, listed here for reference)      │
# └─────────────────────────────────────────────────────────────────────────────┘

# Container timezone
# TZ=UTC
