# Copy this file to .env and fill in the values you need.
# Sections are grouped by the component that reads them.

# LLM connections are configured in Settings > Providers and stored in PostgreSQL.
# Same Fernet key in backend and runtime; required only for database-stored API keys.
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROGENA_PROVIDER_ENCRYPTION_KEY=
# Optional environment-backed credentials (select the source in Settings).
AZURE_OPENAI_API_KEY=
OPENCODE_GO_API_KEY=
# Existing Azure connection imported once on first provider database initialization.
AZURE_OPENAI_BASE_URL=
# Ordinary provider tables use this database on PROGENA_DATABASE_URL's server.
BACKEND_DATABASE_NAME=backend
PROGENA_MODEL_DEFAULT=gpt-5.1-codex-max
# PROGENA_REASONING_ENABLED=true
# PROGENA_REASONING_EFFORT=medium
# PROGENA_REASONING_SUMMARY=detailed
# Max seconds of silence on a streaming model request before it is retried (OpenAI SDK default: 600)
# PROGENA_LLM_TIMEOUT_SECONDS=120
# PROGENA_LLM_MAX_RETRIES=2
# PROGENA_MOCK_LLM=false

# External MCP settings (Progena reads data/config/mcp.json)
JINA_API_KEY=

# Runtime settings
PROGENA_LOG_LEVEL=info
# Heartbeat maintenance intervals in seconds.
# Increase these to reduce background MCP catalog reloads and registry refresh churn.
PROGENA_MCP_REFRESH_SECONDS=900
PROGENA_REGISTRY_REFRESH_SECONDS=900
# PROGENA_LOG_FORMAT=text
PROGENA_IDLE_BACKOFF_SECONDS=30
PROGENA_MAX_BACKOFF_SECONDS=300
PROGENA_BACKOFF_MULTIPLIER=1.5
PROGENA_MAX_ACTIONS_PER_CYCLE=10
PROGENA_CHECKPOINT_INTERVAL_SECONDS=30
PROGENA_INPUT_TIMEOUT_SECONDS=300
# PROGENA_MAX_INPUT_QUEUE_SIZE=100
# PROGENA_MAX_OUTPUT_QUEUE_SIZE=100
# PROGENA_MAX_STREAM_QUEUE_SIZE=1000
# PROGENA_HEALTH_STALE_SECONDS=120
PROGENA_MAX_INNER_ITERATIONS=5
PROGENA_MIN_VERIFICATION_SCORE=0.8
# PROGENA_ITERATION_TIME_LIMIT_SECONDS=600
PROGENA_BUILD_CONFIDENCE_THRESHOLD=0.95
# PROGENA_MAX_BUILD_CONCURRENCY=3
# PROGENA_BUILD_HOOKS=*=decision_log

# Validation tuning
# PROGENA_VALIDATION_EXECUTION_WARNING_MS=60000
# PROGENA_VALIDATION_RESPONSE_WARNING_MS=10000
# PROGENA_VALIDATION_MAX_ERRORS=10
# PROGENA_VALIDATION_MAX_FAILED_PROMPTS=5
# PROGENA_VALIDATION_PATTERN_DETECTION=true
# PROGENA_VALIDATION_DEDUPLICATION=true
# PROGENA_VALIDATION_HISTORICAL_COMPARISON=true
# PROGENA_VALIDATION_LLM_SEVERITY=true
# PROGENA_VALIDATION_PYTHON_TOOLS=true
# PROGENA_VALIDATION_PYTEST_TIMEOUT=120
# PROGENA_VALIDATION_PYRIGHT_TIMEOUT=60
# PROGENA_VALIDATION_MYPY_TIMEOUT=60
# PROGENA_VALIDATION_RUFF_TIMEOUT=30

# Runtime HTTP server and storage
# Postgres data store used by LangGraph checkpointing and Progena-owned tables.
PROGENA_DATABASE_URL=postgresql://progena:progena@localhost:5432/progena
PROGENA_DATABASE_SETUP=true
PROGENA_DATABASE_POOL_MIN_SIZE=1
PROGENA_DATABASE_POOL_MAX_SIZE=10
# PROGENA_HTTP_HOST=127.0.0.1
# PROGENA_HTTP_PORT=9501
# PROGENA_RUNTIME_URL=http://127.0.0.1:9501
# PROGENA_DATA_DIR=./data
# PROGENA_LOG_DIR=./logs
# PROGENA_WORKTREE_DIR=./data/repos
# PROGENA_WORKTREES_ROOT=./data
# Writable /shared/ route; also mount this directory into A2A agent containers.
# PROGENA_SHARED_DIR=/shared
# state lives under $PROGENA_DATA_DIR/state
# prompts live under $PROGENA_DATA_DIR/prompts
# skills live under $PROGENA_DATA_DIR/skills
# declared/scanned repos live under $PROGENA_DATA_DIR/repos
PROGENA_STATE_LOCK_TIMEOUT_SECONDS=10

# Scheduler
PROGENA_SCHEDULER_ENABLED=true
PROGENA_SCHEDULER_POLL_SECONDS=30

# Optional external A2A repositories (Linux: colon-separated checkout roots)
# PROGENA_AGENT_REPOSITORIES=/absolute/path/to/progena.agents

# Backend only
CHAT_SERVER_HOST=0.0.0.0
CHAT_SERVER_PORT=8000
CHAT_SERVER_DEBUG=false
CHAT_SERVER_PROGENA_TIMEOUT=300
# CHAT_SERVER_PROGENA_STOP_TIMEOUT=5
# CHAT_SERVER_PYTHON=python
CHAT_SERVER_API_TITLE=Progena Chat API
CHAT_SERVER_MODEL_NAME=progena-v1
CHAT_SERVER_RATE_LIMIT_ENABLED=true
CHAT_SERVER_RATE_LIMIT_PER_MINUTE=10000
CHAT_SERVER_RATE_LIMIT_PER_HOUR=100000
# CHAT_SERVER_RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=300
# CHAT_SERVER_RATE_LIMIT_STALE_CLIENT_TIMEOUT_SECONDS=3600
CHAT_SERVER_STREAM_ENABLED=true
# CHAT_SERVER_STREAM_CHUNK_DELAY_MS=0

# Telegram (backend only)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_API_TIMEOUT=30
# TELEGRAM_MAX_RETRIES=3
# TELEGRAM_RETRY_DELAY=1.0
# TELEGRAM_MAX_MESSAGE_LENGTH=4096
# TELEGRAM_RATE_LIMIT_PER_MINUTE=30
# Minimum delay between Telegram draft refreshes in milliseconds (default: 1000)
# TELEGRAM_DRAFT_UPDATE_INTERVAL_MS=1000

# --- Polling Settings (for receiving messages) ---
# Enable polling for incoming messages (default: true)
# TELEGRAM_POLLING_ENABLED=true

# Interval between poll cycles in seconds (default: 2.0)
# TELEGRAM_POLLING_INTERVAL=2.0

# Long polling timeout for getUpdates API (default: 30)
# TELEGRAM_POLLING_TIMEOUT=30
# TELEGRAM_ALLOWED_USERS=

# Optional credentials and git identity for built-in repo tooling and standalone ACP runtimes
# GH_TOKEN=
# GITHUB_TOKEN=
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=


# Optional verified pricing seed for a NEW model-profile catalog only.
# Explicit underlying model and tier are required; deployment names are not inferred.
# Azure GPT-5 mini Global Standard USD/1M: input .25, cached input .025, output 2.00.
# PROGENA_MODEL_DEFAULT_MODEL=gpt-5-mini
# PROGENA_MODEL_DEFAULT_PRICING_TIER=global_standard
