# Copy this file to .env and fill in the values you need.
# Sections are grouped by the component that reads them.

# Shared LLM settings
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
PROGENITOR_MODEL_DEFAULT=gpt-5.1-codex-max
# PROGENITOR_REASONING_ENABLED=true
# PROGENITOR_REASONING_EFFORT=medium
# PROGENITOR_REASONING_SUMMARY=detailed
# PROGENITOR_MOCK_LLM=false

# External MCP settings (Progenitor reads data/config/mcp.json)
JINA_API_KEY=

# Runtime settings
PROGENITOR_TIMEZONE=Australia/Melbourne
PROGENITOR_LOG_LEVEL=info
# PROGENITOR_LOG_FORMAT=text
PROGENITOR_IDLE_BACKOFF_SECONDS=30
PROGENITOR_MAX_BACKOFF_SECONDS=300
PROGENITOR_BACKOFF_MULTIPLIER=1.5
PROGENITOR_MAX_ACTIONS_PER_CYCLE=10
PROGENITOR_CHECKPOINT_INTERVAL_SECONDS=30
PROGENITOR_INPUT_TIMEOUT_SECONDS=300
# PROGENITOR_MAX_INPUT_QUEUE_SIZE=100
# PROGENITOR_MAX_OUTPUT_QUEUE_SIZE=100
# PROGENITOR_MAX_STREAM_QUEUE_SIZE=1000
# PROGENITOR_HEALTH_STALE_SECONDS=120
PROGENITOR_MAX_INNER_ITERATIONS=5
PROGENITOR_MIN_VERIFICATION_SCORE=0.8
# PROGENITOR_ITERATION_TIME_LIMIT_SECONDS=600
PROGENITOR_BUILD_CONFIDENCE_THRESHOLD=0.95
# PROGENITOR_MAX_BUILD_CONCURRENCY=3
# PROGENITOR_BUILD_HOOKS=*=decision_log

# Validation tuning
# PROGENITOR_VALIDATION_EXECUTION_WARNING_MS=60000
# PROGENITOR_VALIDATION_RESPONSE_WARNING_MS=10000
# PROGENITOR_VALIDATION_MAX_ERRORS=10
# PROGENITOR_VALIDATION_MAX_FAILED_PROMPTS=5
# PROGENITOR_VALIDATION_PATTERN_DETECTION=true
# PROGENITOR_VALIDATION_DEDUPLICATION=true
# PROGENITOR_VALIDATION_HISTORICAL_COMPARISON=true
# PROGENITOR_VALIDATION_LLM_SEVERITY=true
# PROGENITOR_VALIDATION_PYTHON_TOOLS=true
# PROGENITOR_VALIDATION_PYTEST_TIMEOUT=120
# PROGENITOR_VALIDATION_PYRIGHT_TIMEOUT=60
# PROGENITOR_VALIDATION_MYPY_TIMEOUT=60
# PROGENITOR_VALIDATION_RUFF_TIMEOUT=30

# Runtime HTTP server and storage
# PROGENITOR_HTTP_HOST=127.0.0.1
# PROGENITOR_HTTP_PORT=9501
# PROGENITOR_RUNTIME_URL=http://127.0.0.1:9501
# PROGENITOR_DATA_DIR=./data
# PROGENITOR_LOG_DIR=./logs
# PROGENITOR_WORKTREE_DIR=./data/repos
# PROGENITOR_WORKTREES_ROOT=./data
# state lives under $PROGENITOR_DATA_DIR/state
# prompts live under $PROGENITOR_DATA_DIR/prompts
# skills live under $PROGENITOR_DATA_DIR/skills
# declared/scanned repos live under $PROGENITOR_DATA_DIR/repos
PROGENITOR_STATE_LOCK_TIMEOUT_SECONDS=10

# Copilot ACP settings
# PROGENITOR_COPILOT_BIN=copilot
PROGENITOR_COPILOT_TIMEOUT_SECONDS=1200
PROGENITOR_COPILOT_MODEL=gpt-5.3-codex
PROGENITOR_COPILOT_MAX_TOKENS=8192
PROGENITOR_COPILOT_DEFAULT_FLAGS=--yolo
# PROGENITOR_COPILOT_ACP_PORT=3000
PROGENITOR_COPILOT_ACP_ALLOWED_DIRS=app/progenitor

# Scheduler
PROGENITOR_SCHEDULER_ENABLED=true
PROGENITOR_SCHEDULER_POLL_SECONDS=30

# Optional external A2A repositories (Linux: colon-separated checkout roots)
# PROGENITOR_AGENT_REPOSITORIES=/absolute/path/to/progentior.agents

# Backend only
CHAT_SERVER_HOST=0.0.0.0
CHAT_SERVER_PORT=8000
CHAT_SERVER_DEBUG=false
CHAT_SERVER_PROGENITOR_TIMEOUT=300
# CHAT_SERVER_PROGENITOR_STOP_TIMEOUT=5
# CHAT_SERVER_PYTHON=python
CHAT_SERVER_API_TITLE=Progenitor Chat API
CHAT_SERVER_MODEL_NAME=progenitor-v1
CHAT_SERVER_RATE_LIMIT_ENABLED=true
CHAT_SERVER_RATE_LIMIT_PER_MINUTE=10000
CHAT_SERVER_RATE_LIMIT_PER_HOUR=100000
# CHAT_SERVER_RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=300
# CHAT_SERVER_RATE_LIMIT_STALE_CLIENT_TIMEOUT_SECONDS=3600
CHAT_SERVER_STREAM_ENABLED=true
# CHAT_SERVER_STREAM_CHUNK_DELAY_MS=0

# Telegram (backend only)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_API_TIMEOUT=30
# TELEGRAM_MAX_RETRIES=3
# TELEGRAM_RETRY_DELAY=1.0
# TELEGRAM_MAX_MESSAGE_LENGTH=4096
# TELEGRAM_RATE_LIMIT_PER_MINUTE=30
# Minimum delay between Telegram draft refreshes in milliseconds (default: 1000)
# TELEGRAM_DRAFT_UPDATE_INTERVAL_MS=1000

# --- Polling Settings (for receiving messages) ---
# Enable polling for incoming messages (default: true)
# TELEGRAM_POLLING_ENABLED=true

# Interval between poll cycles in seconds (default: 2.0)
# TELEGRAM_POLLING_INTERVAL=2.0

# Long polling timeout for getUpdates API (default: 30)
# TELEGRAM_POLLING_TIMEOUT=30
# TELEGRAM_ALLOWED_USERS=

# Optional credentials and git identity for built-in repo tooling and standalone ACP runtimes
# GH_TOKEN=
# GITHUB_TOKEN=
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=

# Docker compose reference
# TZ=UTC
