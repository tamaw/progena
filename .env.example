# =============================================================================
# Progenitor Configuration
# =============================================================================
# Environment variables always override JSON config files.
# See SPEC.md for full documentation.

# =============================================================================
# LLM Provider Selection
# =============================================================================
# Provider: "openai" | "azure" (default: azure)
# PROGENITOR_LLM_PROVIDER=azure

# Default model (used when provider doesn't specify deployment)
# PROGENITOR_MODEL_DEFAULT=gpt-5.1-codex-max

# =============================================================================
# Option 1: OpenAI (Public API)
# =============================================================================
# OPENAI_API_KEY=sk-your-api-key-here

# =============================================================================
# Option 2: Azure OpenAI (Recommended)
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-api-key
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_DEFAULT=gpt-4o-deploy

# Optional: Per-role deployments (override default for specific tasks)
# AZURE_OPENAI_DEPLOYMENT_PLANNER=planner-deploy
# AZURE_OPENAI_DEPLOYMENT_BUILDER=builder-deploy
# AZURE_OPENAI_DEPLOYMENT_SUMMARY=summary-deploy

# =============================================================================
# Runtime Configuration
# =============================================================================
# PROGENITOR_TIMEZONE=Australia/Melbourne
# PROGENITOR_IDLE_BACKOFF_SECONDS=30
# PROGENITOR_MAX_ACTIONS_PER_CYCLE=10
# PROGENITOR_LOG_LEVEL=info

# =============================================================================
# Storage Paths (defaults are container-friendly)
# =============================================================================
# PROGENITOR_STATE_DIR=/state
# PROGENITOR_LOG_DIR=/logs
# PROGENITOR_WORKTREE_DIR=/worktrees
# PROGENITOR_STATE_LOCK_TIMEOUT_SECONDS=10

# =============================================================================
# Copilot CLI Configuration
# =============================================================================
# PROGENITOR_COPILOT_BIN=copilot
# PROGENITOR_COPILOT_CONFIG=/config/copilot.json
# PROGENITOR_COPILOT_TIMEOUT_SECONDS=300

# =============================================================================
# Transport Configuration
# =============================================================================
# PROGENITOR_TRANSPORT=whatsapp
# PROGENITOR_INBOX_ENDPOINT=
# PROGENITOR_OUTBOX_ENDPOINT=
# PROGENITOR_ALLOWED_SENDERS=

# =============================================================================
# Scheduler Configuration
# =============================================================================
# PROGENITOR_SCHEDULER_ENABLED=true
# PROGENITOR_SCHEDULER_POLL_SECONDS=30

# =============================================================================
# Chat Server Configuration
# =============================================================================
# Host and port for the FastAPI chat server
# CHAT_SERVER_HOST=0.0.0.0
# CHAT_SERVER_PORT=8000
# CHAT_SERVER_DEBUG=false

# Timeout for Progenitor agent responses
# CHAT_SERVER_PROGENITOR_TIMEOUT=60

# Model name shown in OpenAI-compatible API
# CHAT_SERVER_MODEL_NAME=progenitor-v1
