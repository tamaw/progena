# Keep Docker build contexts small (especially since app/frontend includes node_modules)
.git
.github
.venv
__pycache__
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd

# Local/runtime data
logs
tmp
worktrees
htmlcov
data/*
!data/prompts/
!data/prompts/**
!data/skills/
!data/skills/**
!data/schemas/
!data/schemas/**

# Frontend build artifacts / deps (not needed in Python images)
app/frontend/node_modules
app/frontend/dist
