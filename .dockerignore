# Keep Docker build contexts small (especially since src/frontend includes node_modules)
.git
.github
.venv
__pycache__
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd

# Local/runtime data
logs
tmp
worktrees
htmlcov
data/*
!data/instructions/
!data/instructions/**
!data/skills/
!data/skills/**
!data/schemas/
!data/schemas/**
!data/modules/
!data/modules/**
!data/agents/
!data/agents/**
!data/shims/
!data/shims/**

# Frontend build artifacts / deps (not needed in Python images)
src/frontend/node_modules
src/frontend/dist

# TLS is terminated by host nginx; no certificate assets belong in image contexts.
src/frontend/certs/
docker/backend/certs/
