# Playwright MCP output
.playwright-mcp/

# Node modules (frontend build tooling; should never be committed from root)
node_modules/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!app/frontend/src/lib/
!app/frontend/src/lib/indexedDb.js
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.mypy_cache/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE
.python-version
.vscode/
.idea/
*.swp
*.swo
.codex
.progenitor_worktree

# Project specific
data/state/*.json
# Local runtime SQLite checkpoint DB (and its WAL/SHM sidecars) — runtime state,
# not source.
data/state/conversations.db
data/state/conversations.db-shm
data/state/conversations.db-wal
!data/state/.gitkeep
data/config/*
!data/config/.gitkeep
!data/config/mcp.json
data/memory/
data/sessions/
data/attachments/
logs/
!logs/.gitkeep
data/repos/*
!data/repos/.gitkeep
data/shell-home/
tmp/
.tmp/

# Secrets
.env
.env.local
*.key
*.pem
# Self-signed dev certs, intentionally committed -- see docker/backend/certs
# and app/frontend/certs. Not real secrets: generated for local/LAN TLS
# enforcement, not a production CA-issued cert.
!app/frontend/certs/*.pem
!docker/backend/certs/*.pem

*-cwd
.ruff_cache
.local/
.perf/
