#!/usr/bin/env bash
# Guardrail only: absolute paths can bypass this shim; the container is the boundary.
#
# Read-only git for every shell agent. Agents whose manifest sets
# git_write: true (PROGENITOR_SHIM_GIT_WRITE=1) may also run repository setup:
# clone, fetch, pull --ff-only, switch, worktree add/remove, submodule, branch
# create, remote add/set-url. Agents that also set git_publish: true
# (PROGENITOR_SHIM_GIT_PUBLISH=1) may push a named non-default branch, never
# forced. Commit, and anything that rewrites history or discards work, stays
# refused for everyone.
set -euo pipefail

REAL_PATH="${PROGENITOR_SHIM_SYSTEM_PATH:-/usr/bin:/bin}"
WRITE="${PROGENITOR_SHIM_GIT_WRITE:-}"
PUBLISH="${PROGENITOR_SHIM_GIT_PUBLISH:-}"
deny() { printf 'progenitor-shim: refused: %s\n' "$*" >&2; exit 2; }
need_write() { [[ "$WRITE" == "1" ]] || deny "$*"; }
need_publish() { [[ "$WRITE" == "1" && "$PUBLISH" == "1" ]] || deny "$*"; }

args=("$@")
index=0
while (( index < ${#args[@]} )); do
  arg=${args[index]}
  case "$arg" in
    -C)
      (( index + 1 < ${#args[@]} )) || deny "global option: -C requires a directory"
      ((index += 2))
      ;;
    --no-pager)
      ((index += 1))
      ;;
    -*)
      deny "global option: $arg"
      ;;
    *)
      break
      ;;
  esac
done

(( index < ${#args[@]} )) || deny "missing subcommand"
sub=${args[index]}
remaining=("${args[@]:index + 1}")

case "$sub" in
  status|log|show|diff|rev-parse|rev-list|ls-files|ls-tree|describe|blame|shortlog|cat-file|for-each-ref|count-objects|name-rev|merge-base|grep|whatchanged)
    ;;
  symbolic-ref)
    ref_count=0
    for arg in "${remaining[@]}"; do
      case "$arg" in
        -q|--quiet|--short|--recurse|--no-recurse) ;;
        -*) deny "symbolic-ref option: $arg" ;;
        *) ((ref_count += 1)) ;;
      esac
    done
    (( ref_count == 1 )) || deny "symbolic-ref requires exactly one reference"
    ;;
  branch)
    for arg in "${remaining[@]}"; do
      case "$arg" in
        -d|-D|-m|-M|-c|-C|-f|--delete|--move|--copy|--force|--edit-description)
          deny "branch option: $arg"
          ;;
        --set-upstream|--set-upstream-to|--set-upstream-to=*|-u|--unset-upstream|--track|--track=*|--no-track)
          need_write "branch option: $arg"
          ;;
        -*)
          ;;
        *)
          need_write "branch argument: $arg"
          ;;
      esac
    done
    ;;
  tag)
    for arg in "${remaining[@]}"; do
      case "$arg" in
        -d|-D|-f|--delete|--force|-a|-s|-m|-F)
          deny "tag option: $arg"
          ;;
        -*)
          ;;
        *)
          deny "tag argument: $arg"
          ;;
      esac
    done
    ;;
  remote)
    case "${remaining[0]:-}" in
      -v|--verbose|show|get-url) ;;
      add|set-url) need_write "remote command: ${remaining[0]}" ;;
      *) deny "remote command: ${remaining[0]:-}" ;;
    esac
    ;;
  config)
    case "${remaining[0]:-}" in
      --get|--get-all|--get-regexp|--list|-l) ;;
      *) deny "config option: ${remaining[0]:-}" ;;
    esac
    ;;
  stash)
    case "${remaining[0]:-}" in
      list|show) ;;
      *) deny "stash command: ${remaining[0]:-}" ;;
    esac
    ;;
  worktree)
    case "${remaining[0]:-}" in
      list) ;;
      add|remove|prune|lock|unlock|repair) need_write "worktree command: ${remaining[0]}" ;;
      *) deny "worktree command: ${remaining[0]:-}" ;;
    esac
    for arg in "${remaining[@]}"; do
      case "$arg" in
        -f|--force) deny "worktree option: $arg" ;;
      esac
    done
    ;;
  clone|fetch|submodule)
    need_write "subcommand: $sub"
    for arg in "${remaining[@]}"; do
      case "$arg" in
        -f|--force|--prune-tags|--upload-pack|--upload-pack=*|-u|--config|--config=*|-c) deny "$sub option: $arg" ;;
        deinit|foreach|set-url|set-branch) deny "submodule command: $arg" ;;
      esac
    done
    ;;
  pull)
    need_write "subcommand: pull"
    ff_only=0
    for arg in "${remaining[@]}"; do
      case "$arg" in
        --ff-only) ff_only=1 ;;
        --rebase|--rebase=*|-r|--no-ff|--squash|--force|-f) deny "pull option: $arg" ;;
      esac
    done
    (( ff_only == 1 )) || deny "pull requires --ff-only"
    ;;
  push)
    need_publish "subcommand: push"
    positionals=()
    for arg in "${remaining[@]}"; do
      case "$arg" in
        -u|--set-upstream|-q|--quiet|-v|--verbose) ;;
        -*) deny "push option: $arg" ;;
        *) positionals+=("$arg") ;;
      esac
    done
    # Name the remote and every branch: an implicit push could publish the
    # default branch.
    (( ${#positionals[@]} >= 2 )) || deny "push needs a remote and branch names"
    for branch in "${positionals[@]:1}"; do
      case "$branch" in
        *:*|+*) deny "push refspec: $branch" ;;
        HEAD|main|master) deny "push of branch: $branch" ;;
      esac
    done
    ;;
  switch)
    need_write "subcommand: switch"
    for arg in "${remaining[@]}"; do
      case "$arg" in
        -f|--force|--discard-changes|-C|--force-create|--orphan|--merge|-m) deny "switch option: $arg" ;;
      esac
    done
    ;;
  checkout)
    deny "checkout can discard local changes; use git switch"
    ;;
  *)
    deny "subcommand: $sub"
    ;;
esac

# Network commands authenticate to GitHub with the passed-through GH_TOKEN via
# gh's credential helper; the token never appears in argv or remote URLs.
auth=()
case "$sub" in
  clone|fetch|pull|push|submodule)
    if [[ -n "${GH_TOKEN:-}" ]]; then
      auth=(-c credential.helper= -c 'credential.helper=!gh auth git-credential')
    fi
    ;;
esac

exec /usr/bin/env PATH="$REAL_PATH" git "${auth[@]}" "${args[@]}"
