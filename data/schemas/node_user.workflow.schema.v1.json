{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow User Node",
  "description": "A node that delivers a message to the user via an agent tool (say_to_user, notify_user, or ask_user) in a v1 workflow graph.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "title", "message_type", "message", "level"],
  "properties": {
    "kind": {
      "const": "user"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "message_type": {
      "type": "string",
      "enum": ["say_to_user", "notify_user", "ask_user"]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "notification_title": {
      "description": "Required, non-null, only when message_type is notify_user.",
      "type": ["string", "null"]
    },
    "level": {
      "type": "string",
      "enum": ["info", "warning", "error", "success"]
    }
  }
}
