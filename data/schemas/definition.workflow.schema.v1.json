{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Definition",
  "description": "A graph-native workflow contains event and literal-value sources plus typed value connections. Every connection supplies data and establishes execution dependency.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "enabled", "paused", "version", "graph", "ui", "updated_at", "created_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "enabled": {"type": "boolean"},
    "paused": {"type": "boolean"},
    "version": {"const": 3},
    "graph": {
      "type": "object", "additionalProperties": false, "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"type": "object", "minProperties": 1, "additionalProperties": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "event_type"], "properties": {
            "kind": {"const": "event"}, "title": {"type": "string", "minLength": 1},
            "event_type": {"type": "string", "enum": ["kanban.card.created", "kanban.card.updated", "kanban.card.moved", "kanban.card.deleted", "kanban.card.status_changed", "document.changed"]},
            "from_column": {"type": ["string", "null"], "enum": ["backlog", "plan", "build", "validate", "done", null]},
            "to_column": {"type": ["string", "null"], "enum": ["backlog", "plan", "build", "validate", "done", null]},
            "key_prefix": {"description": "Optional document.changed filter: document kind key prefix (see document_kinds.DOCUMENT_KINDS). Null/omitted means any kind.", "type": ["string", "null"]},
            "key": {"description": "Optional document.changed filter: exact document key. Null/omitted means any key.", "type": ["string", "null"]},
            "action": {"description": "Optional document.changed filter: write action. Null/omitted means any action.", "type": ["string", "null"], "enum": ["upserted", "deleted", null]},
            "output_schema": {"type": ["object", "null"]}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "value", "output_schema"], "properties": {
            "kind": {"const": "data"}, "title": {"type": "string", "minLength": 1}, "value": {}, "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "message", "input_schema", "output_schema"], "properties": {
            "kind": {"const": "agent"}, "title": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "input_schema": {"type": "object"}, "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "input_schema", "output_schema"], "properties": {
            "kind": {"const": "mcp"}, "title": {"type": "string", "minLength": 1}, "input_schema": {"type": "object"}, "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "expression"], "properties": {
            "kind": {"const": "condition"}, "title": {"type": "string", "minLength": 1}, "expression": {"type": "string", "minLength": 1}, "input_schema": {"type": "object"}, "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "message"], "properties": {
            "kind": {"const": "approval"}, "title": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "input_schema": {"type": "object"}, "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "message", "input_schema", "output_schema"], "properties": {
            "kind": {"const": "human_input"}, "title": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "input_schema": {"type": "object"}, "output_schema": {"type": "object"}
          }}
        ]}},
        "edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {
          "from": {"$ref": "#/$defs/edgeEndpoint"}, "to": {"$ref": "#/$defs/edgeEndpoint"}
        }}}
      }
    },
    "ui": {"type": "object"}, "updated_at": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "minLength": 1}
  },
  "$defs": {"edgeEndpoint": {"type": "object", "additionalProperties": false, "required": ["node", "port"], "properties": {"node": {"type": "string", "minLength": 1}, "port": {"type": "string", "minLength": 1}}}}
}
