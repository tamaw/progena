{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Definition",
  "description": "A graph-native workflow contains document-event and literal-value sources plus typed value connections. Every connection supplies data and establishes execution dependency. Event and direct document-node port schemas are derived from the node's document type (document_type:<id> rows) on save.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "enabled", "paused", "version", "graph", "ui", "updated_at", "created_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "readOnly": true},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "enabled": {"type": "boolean"},
    "paused": {"type": "boolean"},
    "version": {"const": 3, "readOnly": true},
    "graph": {
      "type": "object", "additionalProperties": false, "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"type": "object", "minProperties": 1, "additionalProperties": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "document_type"], "properties": {
            "kind": {"const": "event"}, "title": {"type": "string", "minLength": 1},
            "document_type": {"description": "Id of the document type whose create/update/delete events start this workflow.", "type": "string", "minLength": 1},
            "key": {"description": "Optional filter: exact document key. Null/omitted means any document of the type.", "type": ["string", "null"]},
            "operations": {"description": "Optional filter: operations to fire on. Empty/omitted means any.", "type": "array", "uniqueItems": true, "items": {"enum": ["created", "updated", "deleted"]}},
            "changed_fields": {"description": "Optional filter: fire only when at least one of these top-level document fields changed. Empty/omitted means any.", "type": "array", "items": {"type": "string", "minLength": 1}},
            "match": {"description": "Optional filter: equality at dotted output paths, e.g. {\"after.column_id\": \"done\"}.", "type": "object"},

            "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "expression", "timezone"], "properties": {
            "kind": {"const": "cron"}, "title": {"type": "string", "minLength": 1},
            "expression": {"description": "5-field cron expression (minute hour day-of-month month day-of-week), e.g. \"0 9 * * 1-5\". The backend starts a run at each due time.", "type": "string", "minLength": 1},
            "timezone": {"description": "IANA timezone the expression is evaluated in, e.g. \"Australia/Melbourne\".", "type": "string", "minLength": 1},
            "overlap": {"description": "What a fire does while the workflow still has an active run: skip (default) drops it, queue runs it afterwards.", "enum": ["skip", "queue"]},
            "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "value", "output_schema"], "properties": {
            "kind": {"const": "data"}, "title": {"type": "string", "minLength": 1}, "value": {}, "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "document_type"], "properties": {
            "kind": {"const": "document_read"}, "title": {"type": "string", "minLength": 1},
            "document_type": {"type": "string", "minLength": 1},
            "input_schema": {"type": "object"}, "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "document_type"], "properties": {
            "kind": {"const": "document_query"}, "title": {"type": "string", "minLength": 1},
            "document_type": {"type": "string", "minLength": 1},
            "filters": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["field", "op"], "properties": {"field": {"type": "string", "minLength": 1}, "op": {"enum": ["eq", "ne", "lt", "lte", "gt", "gte", "in", "contains", "exists"]}}}},
            "order_by": {"type": ["string", "null"]},
            "order": {"enum": ["asc", "desc"]},
            "limit": {"type": "integer", "minimum": 1, "maximum": 200},
            "input_schema": {"type": "object"}, "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "document_type"], "properties": {
            "kind": {"const": "document_write"}, "title": {"type": "string", "minLength": 1},
            "document_type": {"type": "string", "minLength": 1},
            "input_schema": {"type": "object"}, "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "document_type"], "properties": {
            "kind": {"const": "document_create"}, "title": {"type": "string", "minLength": 1},
            "document_type": {"type": "string", "minLength": 1},
            "input_schema": {"type": "object"}, "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "document_type"], "properties": {
            "kind": {"const": "document_delete"}, "title": {"type": "string", "minLength": 1},
            "document_type": {"type": "string", "minLength": 1},
            "input_schema": {"type": "object"}, "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title"], "properties": {
            "kind": {"const": "unpack"}, "title": {"type": "string", "minLength": 1},
            "input_schema": {"type": "object"}, "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "template"], "properties": {
            "kind": {"const": "format"}, "title": {"type": "string", "minLength": 1},
            "template": {"description": "Plain-text template without front matter. Each {placeholder} root becomes a required input port.", "type": "string", "minLength": 1},
            "input_schema": {"type": "object"}, "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title"], "properties": {
            "kind": {"const": "extract"}, "title": {"type": "string", "minLength": 1}, "prompt": {"type": ["string", "null"]}, "template": {"type": ["string", "null"]}, "schema": {}, "input_schema": {"type": "object"}, "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title"], "properties": {
            "kind": {"const": "agent"}, "title": {"type": "string", "minLength": 1}, "prompt": {"type": ["string", "null"]}, "template": {"type": ["string", "null"]}, "subagent": {"type": ["string", "null"]}, "input_schema": {"type": "object"}, "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "expression"], "properties": {
            "kind": {"const": "condition"}, "title": {"type": "string", "minLength": 1}, "expression": {"type": "string", "minLength": 1}, "input_schema": {"type": "object"}, "output_schema": {"type": "object"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "title", "message"], "properties": {
            "kind": {"const": "approval"}, "title": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "input_schema": {"type": "object"}, "output_schema": {"type": "object"}
          }}
        ]}},
        "edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {
          "from": {"$ref": "#/$defs/edgeEndpoint"}, "to": {"$ref": "#/$defs/edgeEndpoint"}
        }}}
      }
    },
    "ui": {"type": "object"}, "updated_at": {"type": "string", "minLength": 1, "readOnly": true}, "created_at": {"type": "string", "minLength": 1, "readOnly": true}
  },
  "$defs": {"edgeEndpoint": {"type": "object", "additionalProperties": false, "required": ["node", "port"], "properties": {"node": {"type": "string", "minLength": 1}, "port": {"type": "string", "minLength": 1}}}}
}
