{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Definition",
  "description": "One backend-native workflow definition stored as the 'workflow:<id>' document and exposed as a virtual file at /workflows/<id>.json. Edit one workflow file at a time; execution state lives in separate workflow_run:* documents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "enabled",
    "paused",
    "version",
    "trigger",
    "graph",
    "ui",
    "updated_at",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "paused": {
      "type": "boolean"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event_type"],
      "properties": {
        "type": {
          "const": "event"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "kanban.card.created",
            "kanban.card.updated",
            "kanban.card.moved",
            "kanban.card.deleted",
            "kanban.card.status_changed",
            "document.changed"
          ]
        },
        "from_column": {
          "description": "Optional kanban.card.moved filter: only trigger when the card left this column. Null/omitted means any column.",
          "type": ["string", "null"],
          "enum": ["backlog", "plan", "build", "validate", "done", null]
        },
        "to_column": {
          "description": "Optional kanban.card.moved filter: only trigger when the card entered this column. Null/omitted means any column.",
          "type": ["string", "null"],
          "enum": ["backlog", "plan", "build", "validate", "done", null]
        },
        "key_prefix": {
          "description": "Optional document.changed filter: only trigger for documents of this key prefix (see document_kinds.DOCUMENT_KINDS). Null/omitted means any document kind.",
          "type": ["string", "null"]
        },
        "key": {
          "description": "Optional document.changed filter: only trigger for this exact document key. Null/omitted means any key.",
          "type": ["string", "null"]
        },
        "action": {
          "description": "Optional document.changed filter: only trigger for this write action. Null/omitted means any action.",
          "type": ["string", "null"],
          "enum": ["upserted", "deleted", null]
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "title"],
                "properties": {
                  "kind": {
                    "const": "event"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "title", "prompt", "agent_name"],
                "properties": {
                  "kind": {
                    "const": "prompt"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "agent_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "type": ["string", "null"]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "title", "message_type", "message", "level"],
                "properties": {
                  "kind": {
                    "const": "user"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message_type": {
                    "type": "string",
                    "enum": ["say_to_user", "notify_user", "ask_user"]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "notification_title": {
                    "type": ["string", "null"]
                  },
                  "level": {
                    "type": "string",
                    "enum": ["info", "warning", "error", "success"]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "title", "language", "content"],
                "properties": {
                  "kind": {
                    "const": "code"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "language": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1
                  }
                }
                },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "title", "expression"],
                "properties": {
                  "kind": {"const": "condition"},
                  "title": {"type": "string", "minLength": 1},
                  "expression": {"type": "string", "minLength": 1}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "title", "message"],
                "properties": {
                  "kind": {"const": "approval"},
                  "title": {"type": "string", "minLength": 1},
                  "message": {"type": "string", "minLength": 1}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "title", "message_title", "message", "level"],
                "properties": {
                  "kind": {"const": "inbox"},
                  "title": {"type": "string", "minLength": 1},
                  "message_title": {"type": "string", "minLength": 1},
                  "message": {"type": "string", "minLength": 1},
                  "level": {
                    "type": "string",
                    "enum": ["info", "warning", "error", "success"]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "title", "transport", "agent_name", "request", "timeout_seconds"],
                "properties": {
                  "kind": {"const": "agent"},
                  "title": {"type": "string", "minLength": 1},
                  "transport": {"type": "string", "enum": ["a2a", "acp"]},
                  "agent_name": {"type": "string", "minLength": 1},
                  "request": {"type": "string", "minLength": 1},
                  "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
                }
              }
            ]
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": {
                "type": "object",
                "additionalProperties": false,
                "required": ["node", "port"],
                "properties": {
                  "node": {
                    "type": "string",
                    "minLength": 1
                  },
                  "port": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "to": {
                "type": "object",
                "additionalProperties": false,
                "required": ["node", "port"],
                "properties": {
                  "node": {
                    "type": "string",
                    "minLength": 1
                  },
                  "port": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "size"],
            "properties": {
              "position": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y"],
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" }
                }
              },
              "size": {
                "type": "object",
                "additionalProperties": false,
                "required": ["data", "settings"],
                "description": "Two independent sizes remembered per node: 'data' is the compact read-only view, 'settings' is the full editable form. Switching views resizes the node to whichever one it was last left at.",
                "properties": {
                  "data": { "$ref": "#/$defs/dimensions" },
                  "settings": { "$ref": "#/$defs/dimensions" }
                }
              }
            }
          }
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "zoom": { "type": "number" }
          }
        }
      }
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    }
  }
}
