{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Routine Graph",
  "description": "A declarative graph compiled by app.progenitor.routines.factory. Version 2 makes every executable node configuration and edge shape explicit; unknown fields are rejected rather than silently ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "version", "entry", "nodes", "edges"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "const": "2.0.0" },
    "entry": { "$ref": "#/$defs/nodeId" },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "settings": { "$ref": "#/$defs/settings" },
    "input_schema": { "$ref": "#/$defs/dataFieldMap" },
    "output_schema": { "$ref": "#/$defs/dataFieldMap" },
    "$defs": {
      "type": "object",
      "additionalProperties": { "type": "object" },
      "description": "Routine-authored JSON Schema definitions reusable from response_schema with a #/$defs/<name> reference."
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "not": { "enum": ["__seed__", "__project_output__", "__start__", "__end__"] }
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/nodePrompt" },
        { "$ref": "#/$defs/nodeCode" },
        { "$ref": "#/$defs/nodeEval" },
        { "$ref": "#/$defs/nodeSubagent" },
        { "$ref": "#/$defs/nodeAgent" },
        { "$ref": "#/$defs/nodeNoop" },
        { "$ref": "#/$defs/nodeHuman" },
        { "$ref": "#/$defs/nodeForeach" },
        { "$ref": "#/$defs/nodeSubgraph" }
      ]
    },
    "nodeBase": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "description": { "type": "string" },
        "output_key": { "type": "string", "minLength": 1 },
        "label": { "type": ["string", "null"] },
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "nodePrompt": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "required": ["id", "kind", "output_key", "config"], "properties": { "kind": { "const": "prompt" }, "config": { "$ref": "#/$defs/promptConfig" } } }
      ],
      "unevaluatedProperties": false
    },
    "nodeCode": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "required": ["id", "kind", "output_key", "config"], "properties": { "kind": { "const": "code" }, "config": { "$ref": "#/$defs/codeConfig" } } }
      ],
      "unevaluatedProperties": false
    },
    "nodeEval": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "required": ["id", "kind", "output_key", "config"], "properties": { "kind": { "const": "eval" }, "config": { "$ref": "#/$defs/evalConfig" } } }
      ],
      "unevaluatedProperties": false
    },
    "nodeSubagent": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "required": ["id", "kind", "output_key", "config"], "properties": { "kind": { "const": "subagent" }, "config": { "$ref": "#/$defs/subagentConfig" } } }
      ],
      "unevaluatedProperties": false
    },
    "nodeAgent": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "required": ["id", "kind", "output_key", "config"], "properties": { "kind": { "const": "agent" }, "config": { "$ref": "#/$defs/agentConfig" } } }
      ],
      "unevaluatedProperties": false
    },
    "nodeNoop": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "required": ["id", "kind", "output_key"], "properties": { "kind": { "const": "noop" }, "config": { "$ref": "#/$defs/noopConfig" } } }
      ],
      "unevaluatedProperties": false
    },
    "nodeHuman": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "required": ["id", "kind", "output_key", "config"], "properties": { "kind": { "const": "human" }, "config": { "$ref": "#/$defs/humanConfig" } } }
      ],
      "unevaluatedProperties": false
    },
    "nodeForeach": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "required": ["id", "kind", "output_key", "config"], "properties": { "kind": { "const": "foreach" }, "config": { "$ref": "#/$defs/foreachConfig" } } }
      ],
      "unevaluatedProperties": false
    },
    "nodeSubgraph": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        { "required": ["id", "kind", "output_key", "config"], "properties": { "kind": { "const": "subgraph" }, "config": { "$ref": "#/$defs/subgraphConfig" } } }
      ],
      "unevaluatedProperties": false
    },
    "promptConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_template": { "type": "string", "minLength": 1 },
        "prompt_file": { "type": "string", "minLength": 1 },
        "system_prompt": { "type": "string" },
        "response_schema": { "$ref": "#/$defs/responseSchema" },
        "retry": { "$ref": "#/$defs/retryPolicy" },
        "cache": { "$ref": "#/$defs/cachePolicy" }
      },
      "oneOf": [
        { "required": ["prompt_template"], "not": { "required": ["prompt_file"] } },
        { "required": ["prompt_file"], "not": { "required": ["prompt_template"] } }
      ]
    },
    "codeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": { "const": "python" },
        "expression": { "type": "string", "minLength": 1 },
        "expression_file": { "type": "string", "minLength": 1 },
        "inputs": { "$ref": "#/$defs/inputMap" },
        "retry": { "$ref": "#/$defs/retryPolicy" },
        "cache": { "$ref": "#/$defs/cachePolicy" }
      },
      "oneOf": [
        { "required": ["expression"], "not": { "required": ["expression_file"] } },
        { "required": ["expression_file"], "not": { "required": ["expression"] } }
      ]
    },
    "evalConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": { "const": "python" },
        "expression": { "type": "string", "minLength": 1 },
        "expression_file": { "type": "string", "minLength": 1 },
        "inputs": { "$ref": "#/$defs/inputMap" },
        "rubric_prompt": { "type": "string", "minLength": 1 },
        "response_schema": { "$ref": "#/$defs/responseSchema" },
        "retry": { "$ref": "#/$defs/retryPolicy" },
        "cache": { "$ref": "#/$defs/cachePolicy" }
      },
      "oneOf": [
        { "required": ["expression"], "not": { "anyOf": [{ "required": ["expression_file"] }, { "required": ["rubric_prompt"] }] } },
        { "required": ["expression_file"], "not": { "anyOf": [{ "required": ["expression"] }, { "required": ["rubric_prompt"] }] } },
        { "required": ["rubric_prompt"], "not": { "anyOf": [{ "required": ["expression"] }, { "required": ["expression_file"] }] } }
      ]
    },
    "subagentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subagent_name"],
      "properties": {
        "subagent_name": { "type": "string", "minLength": 1 },
        "prompt_template": { "type": "string", "minLength": 1 },
        "prompt_file": { "type": "string", "minLength": 1 },
        "retry": { "$ref": "#/$defs/retryPolicy" },
        "cache": { "$ref": "#/$defs/cachePolicy" }
      },
      "oneOf": [
        { "required": ["prompt_template"], "not": { "required": ["prompt_file"] } },
        { "required": ["prompt_file"], "not": { "required": ["prompt_template"] } }
      ]
    },
    "agentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_name"],
      "properties": {
        "agent_name": { "type": "string", "minLength": 1 },
        "prompt_template": { "type": "string", "minLength": 1 },
        "prompt_file": { "type": "string", "minLength": 1 },
        "response_schema": { "$ref": "#/$defs/responseSchema" },
        "retry": { "$ref": "#/$defs/retryPolicy" },
        "cache": { "$ref": "#/$defs/cachePolicy" }
      },
      "oneOf": [
        { "required": ["prompt_template"], "not": { "required": ["prompt_file"] } },
        { "required": ["prompt_file"], "not": { "required": ["prompt_template"] } }
      ]
    },
    "noopConfig": { "type": "object", "additionalProperties": false },
    "humanConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "message": { "type": "string", "minLength": 1 },
        "allowed_responses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "retry": { "$ref": "#/$defs/retryPolicy" }
      }
    },
    "foreachConfig": {
      "oneOf": [
        { "$ref": "#/$defs/foreachSendConfig" },
        { "$ref": "#/$defs/foreachAgentConfig" }
      ]
    },
    "foreachSendConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "items_from"],
      "properties": {
        "mode": { "const": "send" },
        "items_from": { "type": "string", "minLength": 1 },
        "item_key": { "type": "string", "minLength": 1 },
        "max_items": { "type": "integer", "minimum": 1 }
      }
    },
    "foreachAgentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "items_from", "agent_name", "prompt_template"],
      "properties": {
        "mode": { "const": "agent" },
        "items_from": { "type": "string", "minLength": 1 },
        "agent_name": { "type": "string", "minLength": 1 },
        "prompt_template": { "type": "string", "minLength": 1 },
        "item_key": { "type": "string", "minLength": 1 },
        "max_items": { "type": "integer", "minimum": 1 },
        "max_concurrency": { "type": "integer", "minimum": 1 },
        "retry": { "$ref": "#/$defs/retryPolicy" },
        "cache": { "$ref": "#/$defs/cachePolicy" }
      }
    },
    "subgraphConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subgraph_name"],
      "properties": {
        "subgraph_name": { "type": "string", "minLength": 1 },
        "input_map": { "$ref": "#/$defs/inputMap" },
        "output_map": { "$ref": "#/$defs/inputMap" },
        "retry": { "$ref": "#/$defs/retryPolicy" },
        "cache": { "$ref": "#/$defs/cachePolicy" }
      }
    },
    "inputMap": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "responseSchema": { "type": "object" },
    "cachePolicy": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "object", "additionalProperties": false, "properties": { "ttl": { "type": "integer", "minimum": 0 } } }
      ]
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1 },
        "initial_interval": { "type": "number", "minimum": 0 },
        "backoff_factor": { "type": "number", "minimum": 1 },
        "max_interval": { "type": "number", "minimum": 0 },
        "jitter": { "type": "boolean" },
        "on_exhausted": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route_to"],
          "properties": { "route_to": { "$ref": "#/$defs/nodeId" } }
        }
      }
    },
    "loopGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression"],
      "properties": {
        "expression": { "type": "string", "minLength": 1 },
        "inputs": { "$ref": "#/$defs/inputMap" },
        "on_false": { "anyOf": [{ "$ref": "#/$defs/nodeId" }, { "type": "null" }] }
      }
    },
    "edge": {
      "oneOf": [
        { "$ref": "#/$defs/normalEdge" },
        { "$ref": "#/$defs/fanOutEdge" },
        { "$ref": "#/$defs/fanInEdge" },
        { "$ref": "#/$defs/routerEdge" }
      ]
    },
    "normalEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "level"],
      "properties": {
        "from": { "$ref": "#/$defs/nodeId" },
        "to": { "$ref": "#/$defs/nodeId" },
        "level": { "const": "normal" },
        "loop_guard": { "$ref": "#/$defs/loopGuard" }
      }
    },
    "fanOutEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "level"],
      "properties": {
        "from": { "$ref": "#/$defs/nodeId" },
        "to": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/nodeId" } },
        "level": { "const": "fan_out" },
        "loop_guard": { "$ref": "#/$defs/loopGuard" }
      }
    },
    "fanInEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "level"],
      "properties": {
        "from": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/nodeId" } },
        "to": { "$ref": "#/$defs/nodeId" },
        "level": { "const": "fan_in" }
      }
    },
    "routerEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "level", "router", "state_key", "branches"],
      "properties": {
        "from": { "$ref": "#/$defs/nodeId" },
        "level": { "const": "route" },
        "router": { "const": "state_equals" },
        "state_key": { "type": "string", "minLength": 1 },
        "branches": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/nodeId" } },
        "default": { "$ref": "#/$defs/nodeId" }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retry": { "$ref": "#/$defs/retryPolicy" },
        "recursion_limit": { "type": "integer", "minimum": 1 },
        "cache": { "type": "boolean" }
      }
    },
    "dataFieldMap": { "type": ["object", "null"], "additionalProperties": { "type": "string" } }
  }
}
