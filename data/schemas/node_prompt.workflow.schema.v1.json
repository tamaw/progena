{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Prompt Node",
  "description": "A sequential prompt node executed through the backend IPC path in a v1 workflow graph.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "title", "prompt", "agent_name"],
  "properties": {
    "kind": {
      "const": "prompt"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "agent_name": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": ["string", "null"]
    }
  }
}
