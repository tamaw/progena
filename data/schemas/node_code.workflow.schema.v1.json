{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Code Node",
  "description": "A node that asks the agent to run a code snippet through the backend IPC path (no sandboxed executor) in a v1 workflow graph.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "title", "language", "content"],
  "properties": {
    "kind": {
      "const": "code"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string",
      "minLength": 1
    }
  }
}
