{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow run",
  "description": "One execution of a workflow, stored as the 'workflow_run:<run_id>' document.",
  "type": "object",
  "properties": {
    "run_id": {"type": "string"},
    "workflow_id": {"type": "string"},
    "status": {"type": "string", "enum": ["queued", "running", "paused", "completed", "failed"]},
    "current_node_id": {"type": ["string", "null"]},
    "completed_node_ids": {"type": "array", "items": {"type": "string"}},
    "waiting_node_id": {"type": ["string", "null"]},
    "pending_approval": {"type": ["object", "null"]},
    "thread_id": {"type": ["string", "null"]},
    "trigger_event": {"type": "object"},
    "trigger_node_id": {"type": ["string", "null"]},
    "source": {"type": "string", "enum": ["document", "manual", "progenitor"]},
    "ancestry": {"type": "array", "items": {"type": "string"}},
    "node_outputs": {"type": "object"},
    "last_output": {"type": ["string", "null"]},
    "last_error": {"type": ["string", "null"]},
    "step_audit": {"type": "array", "items": {"type": "object"}},
    "queued_at": {"type": "string"},
    "started_at": {"type": ["string", "null"]},
    "updated_at": {"type": "string"},
    "completed_at": {"type": ["string", "null"]}
  },
  "required": ["run_id", "workflow_id", "status"],
  "additionalProperties": true
}
