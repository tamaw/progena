{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Alert",
  "description": "One user alert: the payload of an alert:<id> document. Producers create it directly; the backend shows it in the alert center and asks Progena to relay it to the user.",
  "type": "object",
  "required": ["id", "type", "title", "message", "timestamp", "urgent", "requires_response", "viewed"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "readOnly": true},
    "type": {"type": "string", "description": "Severity: info, warning, error, critical.", "default": "info"},
    "title": {"type": "string", "minLength": 1},
    "message": {"type": "string"},
    "timestamp": {"type": "number", "description": "Unix seconds when created.", "readOnly": true},
    "urgent": {"type": "boolean", "default": false},
    "requires_response": {"type": "boolean", "default": false},
    "viewed": {"type": "boolean", "default": false},
    "viewed_at": {"type": ["number", "null"], "readOnly": true},
    "source": {"type": "string", "description": "What raised it.", "readOnly": true},
    "context": {
      "type": "object",
      "description": "Machine-readable details for answering it, e.g. a paused workflow run or routine thread and who may answer (approver).",
      "readOnly": true
    }
  },
  "additionalProperties": false
}
