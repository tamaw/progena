{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node_approval.workflow.schema.v1.json",
  "title": "Workflow Approval Node",
  "description": "The 'approval' node configuration accepted in a v1 workflow graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "title",
    "message"
  ],
  "properties": {
    "kind": {
      "const": "approval"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "input_schema": {
      "type": [
        "object",
        "null"
      ]
    },
    "output_schema": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
