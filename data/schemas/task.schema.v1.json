{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kanban task card",
  "description": "A single kanban task card, stored as the 'kanban_card:<id>' document and exposed as a virtual file at /tasks/<id>.md (or /tasks/<project_id>/<id>.md for a project-scoped card). Create or edit a card with the native write/edit file tools against that path; card_order and the Tasks UI update automatically.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "readOnly": true,
      "description": "Unique card identifier (matches the document suffix)."
    },
    "title": {
      "type": "string",
      "description": "Short card title."
    },
    "summary": {
      "type": "string",
      "description": "One-line summary."
    },
    "description": {
      "type": "string",
      "description": "Full task description."
    },
    "column_id": {
      "type": "string",
      "description": "Id of the board column the card belongs to."
    },
    "status": {
      "type": "string",
      "description": "Card status within the workflow."
    },
    "agent_name": {
      "type": "string",
      "description": "Agent responsible for the task."
    },
    "owner": {
      "type": "string",
      "description": "Owner of the card.",
      "default": "user"
    },
    "labels": {
      "type": "array",
      "description": "Free-form labels.",
      "items": {
        "type": "string"
      }
    },
    "position": {
      "type": "integer",
      "description": "Ordering position within the column.",
      "default": 0
    },
    "project_id": {
      "type": ["string", "null"],
      "description": "Project the card belongs to, or null for an unscoped card."
    },
    "spec_path": {
      "type": ["string", "null"],
      "description": "Path to the linked spec, if any."
    },
    "branch_name": {
      "type": ["string", "null"],
      "description": "Linked git branch, if any."
    },
    "repo_id": {
      "type": ["string", "null"],
      "description": "Declared repository id linked to this card, if any."
    },
    "acp_task_id": {
      "type": ["string", "null"],
      "description": "ACP task id linked to this card, if any."
    },
    "pr_url": {
      "type": ["string", "null"],
      "description": "Linked pull request URL, if any."
    },
    "started_at": {
      "type": ["string", "null"],
      "readOnly": true,
      "description": "ISO8601 timestamp when work started."
    },
    "completed_at": {
      "type": ["string", "null"],
      "readOnly": true,
      "description": "ISO8601 timestamp when work completed."
    },
    "last_error": {
      "type": ["string", "null"],
      "description": "Most recent error reported for the card."
    },
    "metadata": {
      "type": "object",
      "description": "Free-form card metadata."
    },
    "created_at": {
      "type": "string",
      "readOnly": true,
      "description": "ISO8601 creation timestamp."
    },
    "updated_at": {
      "type": "string",
      "readOnly": true,
      "description": "ISO8601 last-update timestamp."
    }
  },
  "required": ["id", "title", "summary", "column_id", "status"],
  "additionalProperties": true
}
