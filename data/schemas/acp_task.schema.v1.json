{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ACP Task",
  "description": "One ACP (Agent Client Protocol) session driven by the backend supervisor, stored as an acp_task:<id> document. Writable fields request work: create with status 'queued' to start a session; append a message to steer a working turn or start the next turn when idle; write {prompt, status: 'queued'} to run the next turn on the same session; write {cancel_requested: true} to cancel. Read-only fields are owned by the supervisor.",
  "type": "object",
  "properties": {
    "task_id": {"type": "string", "readOnly": true, "description": "The id part of the acp_task:<id> key."},
    "agent_name": {"type": "string", "minLength": 1, "description": "Registered ACP agent to drive (e.g. 'claude')."},
    "prompt": {"type": "string", "description": "Prompt for the next turn."},
    "cwd": {"type": ["string", "null"], "description": "Working directory on the agent's host, e.g. a repo node's worktree path. Defaults to the agent's configured cwd."},
    "card_id": {"type": ["string", "null"], "description": "Kanban card this task works for, if any."},
    "status": {
      "type": "string",
      "enum": ["queued", "working", "completed", "failed", "canceled", "interrupted"],
      "default": "queued",
      "description": "queued: a turn is requested; working: a turn is running; completed/failed/canceled: the last turn ended; interrupted: the backend restarted during the turn (queue another turn to resume the session)."
    },
    "cancel_requested": {"type": "boolean", "default": false, "description": "Set true to cancel the running or queued turn; reset to false by the supervisor."},
    "messages": {
      "type": "array",
      "default": [],
      "description": "Messages appended by requesters for injection into a running turn or the next turn when idle.",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"},
          "status": {"type": "string", "enum": ["pending", "injected", "started_turn", "failed"]},
          "error": {"type": "string"},
          "sent_at": {"type": "string"}
        },
        "required": ["id", "text", "status"],
        "additionalProperties": false
      }
    },
    "mode": {"type": ["string", "null"], "enum": ["default", "acceptEdits", "plan", "bypassPermissions", null], "description": "Requested session mode, applied when a session starts or resumes and while it is running."},
    "answers": {"type": "object", "default": {}, "additionalProperties": true, "description": "Answers keyed by a supervisor-created pending_input id."},
    "source": {"type": "string", "default": "workflow", "description": "Who requested the task (e.g. 'workflow', or an agent name)."},
    "request_metadata": {"type": "object", "default": {}, "description": "Free-form caller context."},
    "notify_on_completion": {"type": "boolean", "default": false, "description": "Tell Progena's chat when a turn ends."},
    "command": {"type": "string", "readOnly": true, "description": "Agent endpoint used (host:port or command)."},
    "session_id": {"type": ["string", "null"], "readOnly": true, "description": "ACP session id; later turns resume it."},
    "turn": {"type": "integer", "minimum": 0, "readOnly": true, "description": "Number of turns started."},
    "output": {"type": ["string", "null"], "readOnly": true, "description": "Agent reply text of the last finished turn."},
    "evidence": {
      "type": ["object", "null"],
      "readOnly": true,
      "description": "Integrity reference for the retained transcript source of the current or most recently completed turn. This describes where exact transcript detail may be read; it is not task-success or test evidence.",
      "properties": {
        "provider": {"type": "string", "const": "claude_native"},
        "session_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "cwd": {"type": "string"},
        "line_start": {"type": "integer", "minimum": 0},
        "line_end": {"type": "integer", "minimum": 0},
        "byte_start": {"type": "integer", "minimum": 0},
        "byte_end": {"type": "integer", "minimum": 0},
        "block_size": {"type": "integer", "const": 1048576},
        "block_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
        "verified": {"type": "boolean", "const": true},
        "awaiting_identity": {"type": "boolean", "const": true},
        "final_output_available": {"type": "boolean"},
        "final_message_line": {"type": "integer", "minimum": 0},
        "output_truncated": {"type": "boolean"}
      },
      "additionalProperties": false,
      "anyOf": [
        {"type": "null"},
        {
          "required": ["provider", "session_id", "line_start", "byte_start"],
          "not": {
            "anyOf": [
              {"required": ["line_end"]},
              {"required": ["byte_end"]},
              {"required": ["block_size"]},
              {"required": ["block_sha256"]}
            ]
          }
        },
        {
          "required": ["provider", "session_id", "line_start", "line_end", "byte_start", "byte_end", "block_size", "block_sha256"]
        },
        {
          "required": ["output_truncated", "final_output_available"],
          "not": {
            "anyOf": [
              {"required": ["provider"]},
              {"required": ["session_id"]},
              {"required": ["cwd"]},
              {"required": ["line_start"]},
              {"required": ["line_end"]},
              {"required": ["byte_start"]},
              {"required": ["byte_end"]},
              {"required": ["block_size"]},
              {"required": ["block_sha256"]},
              {"required": ["verified"]},
              {"required": ["awaiting_identity"]},
              {"required": ["final_message_line"]}
            ]
          },
          "properties": {
            "output_truncated": {"const": true},
            "final_output_available": {"const": false}
          }
        }
      ]
    },
    "summary": {"type": ["string", "null"], "readOnly": true, "description": "First line of the last output."},
    "stop_reason": {"type": ["string", "null"], "readOnly": true},
    "last_error": {"type": ["string", "null"], "readOnly": true},
    "failure_kind": {"type": ["string", "null"], "enum": ["usage_limit", "error", null], "readOnly": true, "description": "Why the last turn failed: usage_limit when the agent's account hit a session, usage, or rate limit (retry after it resets); error for anything else; null unless status is failed."},
    "tool_calls": {"type": "array", "items": {"type": "object"}, "readOnly": true, "description": "Recent tool calls (bounded)."},
    "progress": {
      "type": "object",
      "readOnly": true,
      "description": "Live progress of the current turn, saved periodically.",
      "properties": {
        "last_message": {"type": ["string", "null"]},
        "plan": {"type": "array"},
        "tool_call_count": {"type": "integer"},
        "last_tool": {"type": ["string", "null"]},
        "last_activity_at": {"type": ["string", "null"]}
      }
    },
    "stalled": {"type": "boolean", "readOnly": true, "description": "True while a working turn has shown no agent activity for PROGENA_ACP_STALL_SECONDS."},
    "stall_episode": {"type": "integer", "minimum": 0, "readOnly": true},
    "material_event_acknowledgements": {"type": "object", "additionalProperties": {"type": "string"}, "readOnly": true},
    "history": {"type": "array", "items": {"type": "object"}, "readOnly": true, "description": "Finished turns: turn, status, prompt, output, summary, stop_reason, last_error, completed_at."},
    "input_history": {"type": "array", "items": {"type": "object"}, "readOnly": true, "description": "Resolved human input requests retained for exact result reads."},
    "pending_input": {
      "type": ["object", "null"],
      "readOnly": true,
      "description": "Human input currently requested by the agent, or null.",
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string", "enum": ["question", "plan", "permission"]},
        "message": {"type": "string"},
        "fields": {"type": "object", "additionalProperties": true},
        "plan": {"type": "string"},
        "tool": {"type": "string"},
        "options": {"type": "array", "items": {"type": "object"}},
        "requested_at": {"type": "string"}
      },
      "required": ["id", "kind", "message", "requested_at"],
      "additionalProperties": false
    },
    "created_at": {"type": "string", "readOnly": true},
    "updated_at": {"type": "string", "readOnly": true},
    "started_at": {"type": ["string", "null"], "readOnly": true},
    "completed_at": {"type": ["string", "null"], "readOnly": true},
    "notification_sent_at": {"type": ["string", "null"], "readOnly": true}
  },
  "required": ["agent_name"],
  "additionalProperties": false
}
