FROM python:3.12-slim

# Generic Dockerfile for self-contained agents living in app/agents/<name>/
# Build context must be the repo root.
# Pass --build-arg AGENT_NAME=<name> to select which agent to package.

ARG AGENT_NAME
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_TRUSTED_HOST
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AGENT_NAME=${AGENT_NAME}

RUN addgroup --system agent && adduser --system --ingroup agent runner

WORKDIR /app

# Copy only the specific agent package
COPY app/agents/${AGENT_NAME}/ /app/agent/

# Install agent-specific requirements
RUN set -eux; \
    install_args="--index-url ${PIP_INDEX_URL}"; \
    if [ -n "${PIP_TRUSTED_HOST:-}" ]; then \
      install_args="$install_args --trusted-host ${PIP_TRUSTED_HOST}"; \
    fi; \
    pip install --no-cache-dir --upgrade pip $install_args && \
    pip install --no-cache-dir $install_args -r /app/agent/requirements.txt

USER runner

EXPOSE 8080

# Agent must expose a FastAPI/ASGI app in agent.py:app
ENTRYPOINT ["python", "-m", "uvicorn", "agent:app", "--host", "0.0.0.0", "--port", "8080"]
WORKDIR /app/agent
