FROM python:3.12-slim

# Generic Dockerfile for self-contained MCP servers living in app/mcp/<name>/
# Build context must be the repo root.
# Pass --build-arg MCP_NAME=<name> to select which MCP server to package.

ARG MCP_NAME
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_TRUSTED_HOST
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MCP_NAME=${MCP_NAME}

RUN addgroup --system mcp && adduser --system --ingroup mcp runner

WORKDIR /app

# Copy only the specific MCP server package
COPY app/mcp/${MCP_NAME}/ /app/server/

# Install MCP-specific requirements
RUN set -eux; \
    install_args="--index-url ${PIP_INDEX_URL}"; \
    if [ -n "${PIP_TRUSTED_HOST:-}" ]; then \
      install_args="$install_args --trusted-host ${PIP_TRUSTED_HOST}"; \
    fi; \
    pip install --no-cache-dir --upgrade pip $install_args && \
    pip install --no-cache-dir $install_args -r /app/server/requirements.txt

USER runner

EXPOSE 8080

# MCP server must expose an ASGI app in server.py:app
ENTRYPOINT ["python", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080"]
WORKDIR /app/server
