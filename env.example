# Heartbeat maintenance intervals in seconds.
# Increase these to reduce background MCP catalog reloads and registry refresh churn.
PROGENITOR_MCP_REFRESH_SECONDS=900
PROGENITOR_REGISTRY_REFRESH_SECONDS=900

# Postgres data store used by LangGraph checkpointing and Progenitor-owned tables.
PROGENITOR_DATABASE_URL=postgresql://progenitor:progenitor@localhost:5432/progenitor
PROGENITOR_DATABASE_SETUP=true
PROGENITOR_DATABASE_POOL_MIN_SIZE=1
PROGENITOR_DATABASE_POOL_MAX_SIZE=10
